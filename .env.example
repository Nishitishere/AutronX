PORT=3000
HOST=127.0.0.1

# Change these before deploying. A local fallback account is created when omitted.
ADMIN_EMAIL=admin@autronx.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional SMTP settings used by the panel-design email endpoint.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-an-app-password
MAIL_FROM=AutronX <mailer@example.com>
MAIL_COPY_TO=info@autronx.com
