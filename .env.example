PORT=3000
HOST=127.0.0.1

# Change these before deploying. A local fallback account is created when omitted.
ADMIN_EMAIL=admin@autronx.com
ADMIN_PASSWORD=replace-with-a-strong-password

# PostgreSQL is required for production. Keep this server-side only.
DATABASE_URL=postgresql://autronx_app:replace-with-a-strong-password@127.0.0.1:5432/autronx

# Optional SMTP settings. When configured, each newly saved panel sends its PDF to the administrator.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sender@gmail.com
SMTP_PASS=replace-with-a-gmail-app-password
MAIL_FROM=AutronX <sender@gmail.com>
ADMIN_NOTIFICATION_EMAIL=admin@gmail.com
